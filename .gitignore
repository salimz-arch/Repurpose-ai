# ═══════════════════════════════════════════════════════════
#  RePurpose AI — Root .gitignore
#  Keeps secrets, databases, builds & dependencies OUT of Git
# ═══════════════════════════════════════════════════════════

# ── 🔐 Environment secrets (JANGAN PERNAH di-commit) ────────
.env
.env.*
!.env.example
*.pem
*.key
*.local

# ── 🐍 Python / Backend ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/

# Windows virtualenv artifacts — HANYA di root repo (jangan match folder app!)
/Include/
/Lib/
/Scripts/
/share/
/pyvenv.cfg

# ── 🗄️ Database & data user (WAJIB exclude) ─────────────────
*.db
*.sqlite
*.sqlite3
backend/uploads/
backend/cookies.txt

# ── ⚛️ Node / Frontend (Next.js) ────────────────────────────
node_modules/
.next/
out/
build/
dist/
.vercel
.turbo
coverage/
*.tsbuildinfo
next-env.d.ts

# ── 📜 Logs & caches ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/

# ── 💻 OS & IDE ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo